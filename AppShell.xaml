<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyApp_SmartBills.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MyApp_SmartBills.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="SmartBills">

    <Shell.ToolbarItems>
        <ToolbarItem Text="Logout" 
                     Clicked="OnLogoutClicked" 
                     Priority="0" />
    </Shell.ToolbarItems>

    <TabBar x:Name="MainTabBar">
        <Tab Title="Dashboard">
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>

        <Tab Title="Transactions">
            <ShellContent ContentTemplate="{DataTemplate views:TransactionsListPage}" />
        </Tab>

        <Tab Title="Warranties">
            <ShellContent ContentTemplate="{DataTemplate views:WarrantiesListPage}" />
        </Tab>

        <Tab Title="Reports">
            <ShellContent ContentTemplate="{DataTemplate views:ReportsPage}" />
        </Tab>

        <Tab Title="Account">
            <ShellContent ContentTemplate="{DataTemplate views:AccountView}" />
        </Tab>

        <Tab x:Name="AdminTab" Title="Admin Panel" IsVisible="False">
            <ShellContent ContentTemplate="{DataTemplate views:AdminView}" />
        </Tab>
    </TabBar>

</Shell>