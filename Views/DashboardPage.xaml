<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyApp_SmartBills.Views.DashboardPage"
             Title="Dashboard"
             FlowDirection="LeftToRight"
             BackgroundColor="#F5F6FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="{Binding WelcomeTitle}" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#2C3E50" 
                   HorizontalOptions="Center" />    

            <Border BackgroundColor="#2ECC71" Stroke="Transparent" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Offset="0,4" Radius="5" Opacity="0.1" Brush="Black"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="Total Balance" TextColor="White" FontSize="14" HorizontalOptions="Center" />
                    <Label Text="{Binding Balance, StringFormat='${0:N2}'}" TextColor="White" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                <Border Grid.Column="0" BackgroundColor="White" Stroke="#E2E8F0" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Income" TextColor="#7F8C8D" FontSize="12" />
                        <Label Text="{Binding TotalIncome, StringFormat='${0:N0}'}" TextColor="#27AE60" FontSize="18" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="White" Stroke="#E2E8F0" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Expenses" TextColor="#7F8C8D" FontSize="12" />
                        <Label Text="{Binding TotalExpenses, StringFormat='${0:N0}'}" TextColor="#C0392B" FontSize="18" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="Recent Transactions" FontSize="18" FontAttributes="Bold" TextColor="#2C3E50" Margin="0,10,0,0" />

            <CollectionView ItemsSource="{Binding RecentTransactions}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White" Stroke="#F0F2F5" Margin="0,5" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">

                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Margin="0,0,15,0">
                                    <Label Text="{Binding Category}" FontAttributes="Bold" FontSize="14" TextColor="#34495E" />
                                    <Label Text="{Binding Date, StringFormat='{0:MM/dd/yyyy}'}" FontSize="11" TextColor="#95A5A6" />
                                </VerticalStackLayout>

                                <Label Grid.Column="1" Text="{Binding Notes}" TextColor="#7F8C8D" FontSize="13" VerticalOptions="Center" LineBreakMode="TailTruncation" />

                                <Label Grid.Column="2" Text="{Binding Amount, StringFormat='${0:N0}'}" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="+ Add New Transaction"
                    BackgroundColor="#2980B9"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="25"
                    Margin="0,15,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>