<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MyApp_SmartBills.Model"
             xmlns:converters="clr-namespace:MyApp_SmartBills.Converters"
             x:Class="MyApp_SmartBills.Views.WarrantyDetailPage"
             Title="Product Details"
             BackgroundColor="#F5F6FA"
             x:DataType="models:WarrantyItem">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:Base64ToImageConverter x:Key="Base64ToImage" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="✏ Edit" Order="Primary" Priority="0" Clicked="OnEditClicked"/>
    </ContentPage.ToolbarItems>

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <Border BackgroundColor="White" Padding="20" StrokeShape="RoundRectangle 15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding ProductName}" FontSize="24" FontAttributes="Bold" TextColor="#1e3c72" HorizontalOptions="Center"/>
                    <BoxView HeightRequest="1" BackgroundColor="#EAECEE" />

                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Purchase Date:" FontAttributes="Bold" TextColor="#7F8C8D"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding PurchaseDate, StringFormat='{0:dd/MM/yyyy}'}" HorizontalOptions="End"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Warranty:" FontAttributes="Bold" TextColor="#7F8C8D"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding WarrantyMonths, StringFormat='{0} Months'}" HorizontalOptions="End"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="Expires On:" FontAttributes="Bold" TextColor="#7F8C8D"/>
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding ExpiryDate, StringFormat='{0:dd/MM/yyyy}'}" TextColor="Red" FontAttributes="Bold" HorizontalOptions="End"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Receipt Copy:" FontAttributes="Bold" FontSize="18" Margin="0,10,0,0" TextColor="#2C3E50"/>

            <Border BackgroundColor="White" Padding="10" StrokeShape="RoundRectangle 10" HeightRequest="450">
                <Image Source="{Binding ReceiptImageSource, Converter={StaticResource Base64ToImage}}" 
                       Aspect="AspectFit"
                       HorizontalOptions="FillAndExpand"
                       VerticalOptions="FillAndExpand" />
            </Border>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
                <Button Grid.Column="0"
                        Text="⬅ Back to List" 
                        BackgroundColor="#7F8C8D" 
                        TextColor="White" 
                        CornerRadius="10" 
                        HeightRequest="50"
                        FontAttributes="Bold"
                        Clicked="OnBackClicked"/>

                <Button Grid.Column="1"
                        Text="🗑 Delete Warranty" 
                        BackgroundColor="#FF3B30" 
                        TextColor="White" 
                        CornerRadius="10" 
                        HeightRequest="50"
                        FontAttributes="Bold"
                        Clicked="OnDeleteClicked"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>