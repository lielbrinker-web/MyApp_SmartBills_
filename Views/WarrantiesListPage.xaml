<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MyApp_SmartBills.ViewModels"
             xmlns:models="clr-namespace:MyApp_SmartBills.Model"
             x:Class="MyApp_SmartBills.Views.WarrantiesListPage"
             Title="My Warranties"
             BackgroundColor="#F5F6FA">

    <ContentPage.BindingContext>
        <viewmodels:WarrantiesListViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*, Auto" Padding="15">

        <RefreshView Grid.Row="0" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Warranties}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="0,50,0,0" Spacing="10">
                        <Label Text="No Warranties Found" FontSize="16" FontAttributes="Bold" TextColor="#7F8C8D" HorizontalOptions="Center"/>
                        <Label Text="Pull down to refresh or add a new product." FontSize="13" TextColor="#95A5A6" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:WarrantyItem">
                        <Border Stroke="{Binding StatusColor}" StrokeThickness="2" Margin="0,8" Padding="15" BackgroundColor="White">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">

                                <VerticalStackLayout Grid.Column="0" Spacing="5">
                                    <Label Text="{Binding ProductName}" FontSize="18" FontAttributes="Bold" TextColor="#2C3E50"/>
                                    <Label Text="{Binding PurchaseDate, StringFormat='Purchased: {0:dd/MM/yyyy}'}" FontSize="13" TextColor="#7F8C8D"/>
                                    <Label Text="{Binding ExpiryDate, StringFormat='Expires: {0:dd/MM/yyyy}'}" FontSize="13" TextColor="#7F8C8D"/>
                                    <Label Text="{Binding WarrantyMonths, StringFormat='Duration: {0} Months'}" FontSize="12" TextColor="#95A5A6"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                                    <Label Text="{Binding DaysRemaining, StringFormat='{0} Days Left'}" 
                                           TextColor="{Binding StatusColor}" 
                                           FontAttributes="Bold" 
                                           FontSize="14" 
                                           HorizontalOptions="End"/>
                                </VerticalStackLayout>

                                <Button Grid.Column="2"
                                        Text="👁"
                                        FontSize="18"
                                        BackgroundColor="#EAECEE"
                                        TextColor="#2C3E50"
                                        WidthRequest="45"
                                        HeightRequest="45"
                                        CornerRadius="22"
                                        VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:WarrantiesListViewModel}}, Path=ViewReceiptCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="1"
                Text="+ Add New Warranty"
                Command="{Binding NavigateToAddWarrantyCommand}"
                BackgroundColor="#1e3c72"
                TextColor="White"
                HeightRequest="55"
                CornerRadius="12"
                FontSize="16"
                FontAttributes="Bold"
                Margin="0,10,0,0"/>
    </Grid>
</ContentPage>