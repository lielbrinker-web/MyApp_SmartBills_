<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MyApp_SmartBills.Views.SignUpView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MyApp_SmartBills.ViewModels"
    x:DataType="viewmodels:SignUpViewModel"
    Title="Sign Up"
    NavigationPage.HasNavigationBar="False"
    FlowDirection="LeftToRight">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#1e3c72" />
            <GradientStop Offset="1.0" Color="#2a5298" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <ScrollView VerticalOptions="Fill">
            <Grid ColumnDefinitions="0.1*,8*,0.1*" RowDefinitions="Auto, Auto, Auto" Padding="0,40">

                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5" Margin="0,0,0,30">
                    <Label
                        Text="Sign Up for SmartBills"
                        TextColor="White"
                        FontSize="32"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Start managing your bills easily"
                        TextColor="#CCCCCC"
                        FontSize="14"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="15">

                    <Label
                        Text="{Binding ErrorMessage}"
                        IsVisible="{Binding SignUpMessageVisible}"
                        TextColor="#FF8E8E"
                        FontSize="14"
                        HorizontalTextAlignment="Center" />

                    <Border Stroke="#A0FFFFFF" StrokeShape="RoundRectangle 12" Padding="15,0" HeightRequest="55" BackgroundColor="#20FFFFFF">
                        <Entry
                            Placeholder="First Name"
                            PlaceholderColor="#CCCCCC"
                            Text="{Binding FirstName}"
                            TextColor="White"
                            FontSize="16" />
                    </Border>

                    <Border Stroke="#A0FFFFFF" StrokeShape="RoundRectangle 12" Padding="15,0" HeightRequest="55" BackgroundColor="#20FFFFFF">
                        <Entry
                            Placeholder="Last Name"
                            PlaceholderColor="#CCCCCC"
                            Text="{Binding LastName}"
                            TextColor="White"
                            FontSize="16" />
                    </Border>

                    <Border Stroke="#A0FFFFFF" StrokeShape="RoundRectangle 12" Padding="15,0" HeightRequest="55" BackgroundColor="#20FFFFFF">
                        <Entry
                            Placeholder="Email Address"
                            PlaceholderColor="#CCCCCC"
                            Text="{Binding UserEmail}"
                            TextColor="White"
                            Keyboard="Email"
                            FontSize="16" />
                    </Border>

                    <Border Stroke="#A0FFFFFF" StrokeShape="RoundRectangle 12" BackgroundColor="#20FFFFFF" HeightRequest="55">
                        <Grid ColumnDefinitions="*, Auto" Padding="15,0">
                            <Entry
                                Grid.Column="0"
                                Placeholder="Password"
                                PlaceholderColor="#CCCCCC"
                                IsPassword="{Binding EntryAsPassword}"
                                Text="{Binding UserPassword}"
                                TextColor="White"
                                FontSize="16"
                                VerticalOptions="Center" />
                            <Button
                                Grid.Column="1"
                                Text="{Binding PasswordIconCode}"
                                Command="{Binding TogglePasswordCommand}"
                                FontFamily="MaterialIcons"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontSize="20"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border Stroke="#A0FFFFFF" StrokeShape="RoundRectangle 12" Padding="15,0" HeightRequest="55" BackgroundColor="#20FFFFFF">
                        <Entry
                            Placeholder="Phone Number"
                            PlaceholderColor="#CCCCCC"
                            Text="{Binding PhoneNumber}"
                            TextColor="White"
                            Keyboard="Telephone"
                            FontSize="16" />
                    </Border>

                    <Button
                        Text="Register &amp; Complete"
                        Command="{Binding SignUpCommand}"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        HeightRequest="60"
                        CornerRadius="12"
                        FontSize="18"
                        FontAttributes="Bold"
                        Margin="0,15,0,0">
                        <Button.Shadow>
                            <Shadow Brush="Black" Offset="0,5" Opacity="0.3" Radius="10" />
                        </Button.Shadow>
                    </Button>

                    <HorizontalStackLayout HorizontalOptions="Center" Margin="0,10,0,0">
                        <Label
                            Text="Already have an account?"
                            TextColor="White"
                            FontSize="15"
                            VerticalTextAlignment="Center" />
                        <Button
                            Text="Sign In here"
                            Command="{Binding NavigateToSignInCommand}"
                            TextColor="#4CAF50"
                            BackgroundColor="Transparent"
                            FontAttributes="Bold"
                            FontSize="15" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#AA000000">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                <ActivityIndicator IsRunning="True" Color="#4CAF50" Scale="1.5" />
                <Label Text="Creating new account..." TextColor="White" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>